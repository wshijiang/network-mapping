# Allowlist: environment configuration, credentials, state and host artifacts
# never enter the Docker build context (including intermediate cache layers).
**
!Cargo.toml
!Cargo.lock
!build.rs
!crates/
!crates/**
!examples/
!examples/**
!src/
!src/**
!docker/
!docker/config.example.toml
!docker/healthcheck.sh
!LICENSE

# Only public documents embedded by Rust; never include arbitrary local docs.
!docs/
!docs/OPEN_API.md
!docs/OPEN_API_MANAGEMENT.md
!docs/OPEN_API_IMPLEMENTATION.md
!docs/*.sql
!docs/open-api/
!docs/open-api/openapi.json

!source/
!source/database/
!source/database/**
!source/open_source_projects.json
!templates/
!templates/**
!assets/
!assets/fonts/
!assets/fonts/**
