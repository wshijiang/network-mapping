# Docker 服务端完整环境变量示例。参数说明：../docs/DOCKER_CONFIGURATION.md
# 复制为 docker/.env 后填写镜像、证书域名和三个必填密钥；不要提交真实配置。
# 已启用行保留基础单机部署设置；其余配置按需取消注释。
# 数字/布尔值不能留空，数组使用 JSON。路径均为容器内路径（SERVER_SQL_DIRECTORY 除外）。
# 修改后执行 docker compose ... up -d --force-recreate；restart 不更新环境。
# 仅支持本文件列出的基础 NM__ 字段；仅限 TOML 的字段见 config.example.toml 注释。

# ---- Compose 与镜像环境变量 ----
# 服务端镜像；模板要求显式指定版本或 digest，.env.example 的版本占位符必须替换
SERVER_IMAGE=ghcr.io/wshijiang/network-mapping-server:vREPLACE_WITH_APPROVED_VERSION
# 健康检查使用的证书 DNS 名；不是明文 HTTP 开关，也不会生成证书
SERVER_TLS_NAME=server.example.com
# 可选：HTTPS 健康探针的容器内 CA 路径
# SERVER_TLS_CA_FILE=/etc/network-mapping/tls/ca.pem
# 宿主机端口绑定地址；直接对外提供服务可显式改为 0.0.0.0
SERVER_BIND_ADDRESS=127.0.0.1
# 宿主机发布端口，与容器监听端口可不同
SERVER_PUBLISH_PORT=9999
# 默认同时启用本地 PG/ES；可仅保留 local-postgres 或 local-elasticsearch，清空则全部使用外部服务。
COMPOSE_PROFILES=local-postgres,local-elasticsearch
# 宿主机 PG 的 NAT 部署模板见 .env.host-db.example；需配置 PG 监听、授权和防火墙。
# 仅使用 compose.sql.example.yml 时必填；目录必须已存在且允许 UID 10001 读取。
# 同时按需将下面的 INIT_DATABASE_FILE/SQL_FILE_PATH 改为 /etc/network-mapping/sql/ 下的路径。
# SERVER_SQL_DIRECTORY=/srv/network-mapping/sql
# 数据库中没有管理员时创建初始管理员的用户名；密码随机生成，不通过环境变量指定；已有管理员不受影响
# NM_DEFAULT_ADMIN_USERNAME=admin
# 例如 info,network_mapping_server=debug；控制文件日志，完整终端日志还需 --verbose；默认终端仍只显示启动摘要、警告和错误
# RUST_LOG=info

# ---- 监听、安全与 HTTPS ----
# 容器内监听地址，不能为空；宿主机绑定地址由 SERVER_BIND_ADDRESS 控制
NM__SERVER__HOST=0.0.0.0
# 容器监听端口，正常部署使用 1–65535；Compose 映射与镜像健康检查均使用此变量
NM__SERVER__PORT=9999
# 32 字节 Base64 密钥，通常为 44 字符；用 openssl rand -base64 32 生成并长期保存
NM__SERVER__ENCRYPT_KEY=
# 全局请求体上限，必须大于 0；部分接口有独立上限，见扫描器诊断
# NM__SERVER__MAX_BODY_SIZE=67108864
# 去除首尾空白后至少 32 字符，建议 openssl rand -hex 32；变更会使已有扫描器令牌失效
NM__SECURITY__SCANNER_TOKEN_PEPPER=
# 标准 bridge 部署保持 TLS；本地 HTTP 使用 compose.host.example.yml 和 .env.host.example
NM__TLS__ENABLED=true
# PEM 证书链，需与私钥匹配
# NM__TLS__CERTIFICATE_CHAIN_FILE=/etc/network-mapping/tls/cert.pem
# PEM 私钥，需允许 UID 10001 读取
# NM__TLS__PRIVATE_KEY_FILE=/etc/network-mapping/tls/key.pem

# ---- PostgreSQL ----
# PG 主机名或 IP，不能为空
NM__DATABASE__HOST=postgres
# PG 服务端口
NM__DATABASE__PORT=5432
# 应用数据库角色，不能为空
NM__DATABASE__USERNAME=network_mapping
# 示例同时用于本地 PG 初始化；修改 env 不会自动修改已有数据卷中的角色密码
NM__DATABASE__PASSWORD=
# 数据库名，不能为空；外部 PG 需提前创建数据库和角色
NM__DATABASE__DB_NAME=network_mapping
# 最大连接数，必须大于 0
# NM__DATABASE__POOL_MAX_SIZE=10
# 等待空闲连接的超时，必须大于 0
# NM__DATABASE__POOL_WAIT_TIMEOUT_MS=2000
# 新建连接超时，必须大于 0
# NM__DATABASE__POOL_CREATE_TIMEOUT_MS=5000
# 回收检查超时，必须大于 0
# NM__DATABASE__POOL_RECYCLE_TIMEOUT_MS=3000
# 兼容字段；当前使用 tokio_postgres::NoTls，设为 true 也不会启用 PG TLS
# NM__DATABASE__TLS=false
# 启动初始化 SQL，不能为空；默认使用镜像内置文件
# NM__DATABASE__INIT_DATABASE_FILE=/opt/network-mapping/source/database/init.sql
# 查询 SQL 目录，保留结尾 /
# NM__DATABASE__SQL_FILE_PATH=/opt/network-mapping/source/database/

# ---- Elasticsearch 连接与存储 ----
# ES 必须启用。认证仅选 API_KEY 或 USERNAME+PASSWORD；不使用的认证项保持注释。
# 当前必须为 true，不支持禁用 ES
# NM__ELASTICSEARCH__ENABLED=true
# 当前必须为 true
# NM__ELASTICSEARCH__READ_ENABLED=true
# 仅接受此值；不支持 postgres 或 dual
# NM__ELASTICSEARCH__SCAN_STORAGE=elasticsearch
# 当前必须为 false，不支持 PG 扫描事实回退
# NM__ELASTICSEARCH__FALLBACK_TO_POSTGRES=false
# HTTP(S) 地址，不得内嵌用户名或密码
# NM__ELASTICSEARCH__URL=http://elasticsearch:9200
# 仅支持正式 9.5.N；旧 9.5.N 配置也表示允许整个 9.5 系列
# NM__ELASTICSEARCH__EXPECTED_VERSION=9.5.x
# 与用户名/密码认证互斥；也支持 NM__ELASTICSEARCH__API_KEY_FILE
# NM__ELASTICSEARCH__API_KEY=replace-with-api-key
# 必须与 PASSWORD 同时提供；也支持 NM__ELASTICSEARCH__USERNAME_FILE
# NM__ELASTICSEARCH__USERNAME=network_mapping
# 必须与 USERNAME 同时提供；也支持 NM__ELASTICSEARCH__PASSWORD_FILE
# NM__ELASTICSEARCH__PASSWORD=replace-with-password
# 私有 CA 的容器内文件路径；可放入已挂载的 TLS 目录
# NM__ELASTICSEARCH__CA_CERTIFICATE_FILE=/etc/network-mapping/tls/elasticsearch-ca.pem
# 原始扫描观察月索引前缀
# NM__ELASTICSEARCH__OBSERVATION_INDEX_PREFIX=network-mapping-scan-observations-v1
# 执行端点索引
# NM__ELASTICSEARCH__EXECUTION_ENDPOINT_INDEX=network-mapping-execution-endpoints-v1
# 当前端点投影索引
# NM__ELASTICSEARCH__CURRENT_ENDPOINT_INDEX=network-mapping-endpoints-current-v2
# DNS 观察 Data Stream 名称
# NM__ELASTICSEARCH__DNS_OBSERVATION_DATA_STREAM=network-mapping-dns-observations
# 当前 DNS 记录投影索引
# NM__ELASTICSEARCH__DNS_RECORD_INDEX=network-mapping-dns-records-v1
# DNS 观察保留期，30–365
# NM__ELASTICSEARCH__DNS_OBSERVATION_RETENTION_DAYS=180
# 扫描索引副本数，0–5；单节点示例为 0
# NM__ELASTICSEARCH__SCAN_NUMBER_OF_REPLICAS=0
# Bulk 写入分片等待数，接受 1、all 或正整数；单节点使用 1
# NM__ELASTICSEARCH__WRITE_WAIT_FOR_ACTIVE_SHARDS=1
# 仅兼容名称，当前配置类型不再使用该字段；应删除，设置不会改变索引
# NM__ELASTICSEARCH__INDEX=network-mapping-assets-v1

# ---- Elasticsearch 吞吐、超时与历史迁移 ----
# 单次请求超时，必须大于 0
# NM__ELASTICSEARCH__REQUEST_TIMEOUT_SECONDS=30
# 后台队列轮询间隔，100–60000
# NM__ELASTICSEARCH__POLL_INTERVAL_MS=500
# Bulk 批量操作数上限，1–2000
# NM__ELASTICSEARCH__BULK_BATCH_SIZE=500
# 进程内 Bulk 并发上限，1–32
# NM__ELASTICSEARCH__BULK_MAX_CONCURRENCY=2
# 暂时失败最大重试次数，0–10
# NM__ELASTICSEARCH__BULK_MAX_RETRIES=4
# 指数退避初始间隔，10–60000
# NM__ELASTICSEARCH__BULK_RETRY_INITIAL_MS=200
# 包含排队、请求、退避和重试的总预算，1–300
# NM__ELASTICSEARCH__BULK_TOTAL_TIMEOUT_SECONDS=25
# PG→ES 历史迁移并发执行数，1–32
# NM__ELASTICSEARCH__SCAN_MIGRATION_CONCURRENCY=4
# 迁移调度分页大小，1–10000，不能小于迁移并发数
# NM__ELASTICSEARCH__SCAN_MIGRATION_PAGE_SIZE=100
# 每累计至少该数量的新迁移批次保存进度，必须大于 0
# NM__ELASTICSEARCH__SCAN_MIGRATION_CHECKPOINT_BATCHES=100

# ---- 日志、资源路径与密码哈希 ----
# 文件日志目录，必须可写，模板已挂载日志卷
# NM__LOG__DIRECTORY=/var/log/network-mapping
# 日志文件名
# NM__LOG__FILE_NAME=server.json
# 0 按天、1 按小时、2 按分钟，其他 u8 值不滚动；不自动清理旧文件
# NM__LOG__FILE_ROLLING=0
# 系统资源采样间隔，必须大于 0
# NM__LOG__STATUS_DURATION=5
# HTML 模板匹配路径
# NM__TEMPLATES__TEMPLATES_DIRECTORY=/opt/network-mapping/templates/**/*.html
# 错误页模板名称
# NM__TEMPLATES__TEMPLATES_NAME=error.html
# 已构建的前端目录，缺失页面或资源返回 404
# NM__FRONTEND__DIRECTORY=/opt/network-mapping/frontend/dist
# 可选 MMDB 数据目录；缺失时相关 IP 情报字段为空
# NM__MAXMIND__DIRECTORY=/var/lib/network-mapping/maxmind
# 可写诊断存储；持有独占目录锁，部署限制见诊断指南
# NM__SCANNER_DIAGNOSTICS__DIRECTORY=/var/lib/network-mapping/scanner-diagnostics
# Argon2id 内存参数，代码换算为 KiB；需满足 Argon2 参数约束
# NM__PWD_HASH__M=64
# Argon2id 迭代次数，需满足 Argon2 参数约束
# NM__PWD_HASH__T=2
# Argon2id 并行度，需满足 Argon2 参数约束
# NM__PWD_HASH__P=2

# ---- pgBackRest 桥接 ----
# 默认镜像不含 pgBackRest/sudo；启用前准备二进制、权限、配置和数据访问。
# 是否启用 Web 备份桥接
# NM__BACKUP__ENABLED=false
# 启用后必须为绝对路径
# NM__BACKUP__BINARY=/usr/bin/pgbackrest
# 非空，仅字母、数字、下划线、连字符
# NM__BACKUP__STANZA=network_mapping
# 使用 pgBackRest 默认查找规则；设置后使用指定配置文件
# NM__BACKUP__CONFIG_FILE=/etc/pgbackrest/pgbackrest.conf
# 默认以服务进程用户执行；指定后通过 sudo 切换到有效的非 root 本机账户
# NM__BACKUP__RUN_AS_USER=postgres
# 指定 RUN_AS_USER 时使用，必须为绝对路径
# NM__BACKUP__SUDO_BINARY=/usr/bin/sudo
# 命令超时，必须大于 0
# NM__BACKUP__COMMAND_TIMEOUT_SECONDS=21600
# 命令输出上限，至少 4096
# NM__BACKUP__MAX_OUTPUT_BYTES=1048576

# ---- 请求日志与监控 ----
# 仅在对应数据库运行策略缺失时提供初始值，不能覆盖已发布的 Web 配置。
# 请求日志采集开关
# NM__REQUESTS__ENABLED=true
# 保留期，至少 1
# NM__REQUESTS__RETENTION_DAYS=30
# 健康监控总开关
# NM__MONITOR__ENABLED=true
# Web 慢请求阈值，必须大于 0
# NM__MONITOR__SLOW_REQUEST_THRESHOLD_MS=3000
# 5xx 告警开关
# NM__MONITOR__SERVER_ERROR_ENABLED=true
# 慢 SQL 阈值，必须大于 0，依赖 pg_stat_statements
# NM__MONITOR__SLOW_SQL_THRESHOLD_MS=3000
# 慢 SQL 检查间隔，1–86400
# NM__MONITOR__SLOW_SQL_CHECK_INTERVAL_SECONDS=60
# ES 查询警告阈值，必须大于 0
# NM__MONITOR__ELASTICSEARCH_QUERY_WARNING_THRESHOLD_MS=1000
# ES 查询严重阈值，不小于查询警告阈值
# NM__MONITOR__ELASTICSEARCH_QUERY_CRITICAL_THRESHOLD_MS=3000
# ES 写入警告阈值，必须大于 0
# NM__MONITOR__ELASTICSEARCH_WRITE_WARNING_THRESHOLD_MS=5000
# ES 写入严重阈值，不小于写入警告阈值
# NM__MONITOR__ELASTICSEARCH_WRITE_CRITICAL_THRESHOLD_MS=15000
# 同一告警冷却窗口，必须大于 0
# NM__MONITOR__ALERT_COOLDOWN_SECONDS=300

# ---- 自动目标生成 ----
# 仅在数据库缺失运行策略时初始化；后续通过 Web 管理。启用前配置授权网段。
# IPv4 周期生成开关；启用需提供 IPv4 授权范围
# NM__AUTOMATIC_TARGET__ENABLED=false
# 接受 sequential_subnet 或 smart_refresh
# NM__AUTOMATIC_TARGET__STRATEGY=sequential_subnet
# 调度间隔，至少 5
# NM__AUTOMATIC_TARGET__INTERVAL_SECONDS=30
# IPv4 队列低水位，满足 0 ≤ low ≤ high
# NM__AUTOMATIC_TARGET__PENDING_LOW_WATERMARK=2
# IPv4 队列高水位，1–100
# NM__AUTOMATIC_TARGET__PENDING_HIGH_WATERMARK=5
# 自动任务优先级，0–4
# NM__AUTOMATIC_TARGET__PRIORITY=0
# IPv4 授权网段，不允许重叠，不能小于任务网段
# NM__AUTOMATIC_TARGET__AUTHORIZED_CIDRS='[]'
# IPv4 排除网段，排除优先
# NM__AUTOMATIC_TARGET__EXCLUDED_CIDRS='[]'
# IPv4 任务网段前缀，0–32
# NM__AUTOMATIC_TARGET__IPV4_TASK_PREFIX=24
# IPv6 周期生成开关；启用需提供 IPv6 授权范围
# NM__AUTOMATIC_TARGET__IPV6_ENABLED=false
# IPv6 授权网段，不允许重叠，不能小于任务网段；划分后的任务数须能以 128 位游标表示
# NM__AUTOMATIC_TARGET__IPV6_AUTHORIZED_CIDRS='[]'
# IPv6 排除网段，排除优先
# NM__AUTOMATIC_TARGET__IPV6_EXCLUDED_CIDRS='[]'
# IPv6 任务网段前缀，0–128；默认每任务最多 256 个地址
# NM__AUTOMATIC_TARGET__IPV6_TASK_PREFIX=120
# IPv6 队列低水位，满足 0 ≤ low ≤ high
# NM__AUTOMATIC_TARGET__IPV6_PENDING_LOW_WATERMARK=1
# IPv6 队列高水位，1–100
# NM__AUTOMATIC_TARGET__IPV6_PENDING_HIGH_WATERMARK=2
# 非空端口/范围清单，1–65535，例如 22,80,443,8000-8100
# NM__AUTOMATIC_TARGET__COMMON_PORTS=21,22,23,25,53,80,110,135,139,143,443,445,465,587,993,995,1433,1521,2049,2375,2376,3000,3306,3389,5432,5900,6379,8080,8443,9200,11211,27017
# 重复刷新间隔，1–315360000
# NM__AUTOMATIC_TARGET__REPEAT_AFTER_SECONDS=604800
# 失败退避，30–86400
# NM__AUTOMATIC_TARGET__FAILURE_BACKOFF_SECONDS=300
# 变化复核间隔，30–86400
# NM__AUTOMATIC_TARGET__CHANGE_REFRESH_SECONDS=3600

# ---- DNS 后续任务与分析快照 ----
# 仅在对应数据库运行策略缺失时提供初始值，不能覆盖已发布的 Web 配置。
# 根据 DNS A/AAAA 生成端口任务；启用需提供授权范围
# NM__DNS_FOLLOW_UP__ENABLED=false
# IPv4/IPv6 授权范围，同类网段不得重复或重叠
# NM__DNS_FOLLOW_UP__AUTHORIZED_CIDRS='[]'
# IPv4/IPv6 排除范围，排除优先，同类网段不得重复或重叠
# NM__DNS_FOLLOW_UP__EXCLUDED_CIDRS='[]'
# 每任务最多派生目标数，1–500
# NM__DNS_FOLLOW_UP__MAX_TARGETS_PER_TASK=100
# realtime 不运行快照 worker；shadow 生成快照；snapshot 使用快照读取
# NM__ANALYTICS_SNAPSHOT__MODE=realtime
# 快照间隔，1–1440
# NM__ANALYTICS_SNAPSHOT__INTERVAL_MINUTES=30

# ---- 文件密钥输入（可选，替换直接值，不能与直接值同时存在） ----
# 每个已支持的 NM__ 基础字段均可追加 _FILE；下面列出常用密钥示例。
# 先在 compose.example.yml 启用对应 secrets，宿主机文件需允许 UID 10001 读取。
# 删除上面对应的直接值行（即使为空）；本地 PG 同时改用 POSTGRES_PASSWORD_FILE。
# NM__SERVER__ENCRYPT_KEY_FILE=/run/secrets/server-encrypt-key
# NM__SECURITY__SCANNER_TOKEN_PEPPER_FILE=/run/secrets/scanner-token-pepper
# NM__DATABASE__PASSWORD_FILE=/run/secrets/database-password
# NM__ELASTICSEARCH__API_KEY_FILE=/run/secrets/elasticsearch-api-key
# NM__ELASTICSEARCH__USERNAME_FILE=/run/secrets/elasticsearch-username
# NM__ELASTICSEARCH__PASSWORD_FILE=/run/secrets/elasticsearch-password

# ---- 可选登录人机验证（默认关闭，修改后重建容器） ----
# NM__HUMAN_VERIFICATION__PROVIDER=none
# NM__HUMAN_VERIFICATION__ACTIONS=["login"]
# NM__HUMAN_VERIFICATION__TIMEOUT_MS=3000
# NM__HUMAN_VERIFICATION__CONNECT_TIMEOUT_MS=1000
# NM__HUMAN_VERIFICATION__MAX_IN_FLIGHT=32
# NM__HUMAN_VERIFICATION__SEND_REMOTE_IP=false
# NM__HUMAN_VERIFICATION__TURNSTILE__SITE_KEY=
# NM__HUMAN_VERIFICATION__TURNSTILE__SECRET_KEY=
# 文件输入与直接值互斥；先添加只读 Secret 挂载，再使用下面的容器内路径。
# NM__HUMAN_VERIFICATION__TURNSTILE__SECRET_KEY_FILE=/run/secrets/turnstile_secret
# 启用时将允许域名改为实际登录域名，例如 ["console.example.com"]
# NM__HUMAN_VERIFICATION__TURNSTILE__ALLOWED_HOSTNAMES=[]
