# Standard NAT/bridge Compose, with PostgreSQL on the Docker host.
# On first install copy this to docker/.env and use compose.example.yml.
SERVER_IMAGE=ghcr.io/wshijiang/network-mapping-server:vREPLACE_WITH_APPROVED_VERSION
SERVER_TLS_NAME=server.example.com
SERVER_BIND_ADDRESS=127.0.0.1
SERVER_PUBLISH_PORT=9999
COMPOSE_PROFILES=local-elasticsearch
NM__SERVER__HOST=0.0.0.0
NM__SERVER__PORT=9999
NM__TLS__ENABLED=true
# Keep existing deployment keys and credentials when changing configuration.
NM__SERVER__ENCRYPT_KEY=
NM__SECURITY__SCANNER_TOKEN_PEPPER=
NM__DATABASE__HOST=host.docker.internal
NM__DATABASE__PORT=5432
NM__DATABASE__USERNAME=network_mapping
NM__DATABASE__PASSWORD=
NM__DATABASE__DB_NAME=network_mapping
# Host PG must listen on a bridge-reachable interface and authorize the container.
# If ES also runs on the host, clear COMPOSE_PROFILES and set:
# NM__ELASTICSEARCH__URL=http://host.docker.internal:9200
# Offline import cache, inside the persistent server-data volume; writable by UID 10001.
NM_INTEL_CACHE_ROOT=/var/lib/network-mapping/intel-cache
